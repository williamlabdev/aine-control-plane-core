{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aine.dev/schemas/control-plane/integration-observation.v1.schema.json",
  "title": "AINE Control Plane Integration Observation v1",
  "description": "Portable report-only link between a native Orvena/airt run and a Registry snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "correlation_id",
    "producer",
    "project_id",
    "run_id",
    "snapshot_id",
    "native_schema",
    "native_digest",
    "status",
    "claims",
    "read_only"
  ],
  "properties": {
    "schema": {"const": "aine.control-plane.integration-observation.v1"},
    "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "producer": {"enum": ["orvena", "airt"]},
    "project_id": {"enum": ["aine.orvena", "aine.airt"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "native_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "native_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["success", "failure", "unknown", "conflict"]},
    "claims": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "read_only": {"const": true}
  }
}
