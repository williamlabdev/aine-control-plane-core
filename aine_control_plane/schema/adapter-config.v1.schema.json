{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aine.dev/schemas/control-plane/adapter-config.v1.schema.json",
  "title": "AINE Control Plane Adapter Config v1",
  "$defs": {
    "portable_value": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {
          "type": "string",
          "not": {"pattern": "^(?:/|~/|\\./|\\.\\./|[Ff][Ii][Ll][Ee]://)"}
        },
        {"type": "array", "items": {"$ref": "#/$defs/portable_value"}},
        {"$ref": "#/$defs/portable_object"}
      ]
    },
    "portable_object": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "not": {
              "pattern": "(^|[-_])(?:[Aa][Cc][Cc][Ee][Ss][Ss][-_]?[Kk][Ee][Yy]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][-_]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee]|[Dd][Ii][Rr]|[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|[Rr][Oo][Oo][Tt]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee]|[Ll][Oo][Cc][Aa][Ll][-_]?[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee][-_]?[Pp][Aa][Tt][Hh]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee][-_]?[Rr][Oo][Oo][Tt])([-_]|$)"
            }
          },
          {
            "not": {
              "pattern": "(^|[-_])(?:[Aa][Cc][Cc][Ee][Ss][Ss][-_]?[Kk][Ee][Yy]|[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][-_]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee]|[Dd][Ii][Rr]|[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|[Rr][Oo][Oo][Tt]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee]|[Ll][Oo][Cc][Aa][Ll][-_]?[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee][-_]?[Pp][Aa][Tt][Hh]|[Ww][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee][-_]?[Rr][Oo][Oo][Tt])([A-Z]|[-_]|$)"
            }
          },
          {
            "not": {
              "pattern": "(?:^|[A-Za-z0-9])(?:[A][Cc][Cc][Ee][Ss][Ss][-_]?[Kk][Ee][Yy]|[A][Pp][Ii][-_]?[Kk][Ee][Yy]|[P][Rr][Ii][Vv][Aa][Tt][Ee][-_]?[Kk][Ee][Yy])(?:[A-Z]|[-_]|$)"
            }
          },
          {
            "not": {
              "pattern": "[A-Za-z](?:[T][Oo][Kk][Ee][Nn]|[S][Ee][Cc][Rr][Ee][Tt]|[P][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[C][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[P][Aa][Tt][Hh]|[F][Ii][Ll][Ee]|[D][Ii][Rr]|[R][Oo][Oo][Tt]|[W][Oo][Rr][Kk][Ss][Pp][Aa][Cc][Ee])(?:[A-Z]|[-_]|$)"
            }
          },
          {
            "not": {
              "pattern": "[Aa][Pp][Ii][_-]{2,}[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]{2,}[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]{2,}[Kk][Ee][Yy]"
            }
          }
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/portable_value"}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter_id", "kind", "contract_version", "options", "credential_refs", "read_only"],
  "properties": {
    "schema": {"const": "aine.control-plane.adapter-config.v1"},
    "adapter_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["evidence_source", "evidence_sink", "identity", "portfolio_view", "retention"]},
    "contract_version": {"const": "aine.control-plane.contracts.v1"},
    "options": {"$ref": "#/$defs/portable_object"},
    "credential_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s/?#\\[\\]]+(?:/[^\\s?#]*)?$"},
          {"not": {"pattern": "^[Ff][Ii][Ll][Ee]://"}},
          {"not": {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*@"}},
          {"not": {"pattern": "[?#]"}},
          {
            "if": {"pattern": "^[Ee][Nn][Vv]://"},
            "then": {"pattern": "^[Ee][Nn][Vv]://[A-Za-z_][A-Za-z0-9_]*$"}
          }
        ]
      }
    },
    "read_only": {"const": true}
  }
}
